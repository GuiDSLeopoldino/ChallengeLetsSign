<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif; line-height: 1.6; color: #1f2330; background-color: #f7f7f9; }
    .email-wrapper { max-width: 600px; margin: 0 auto; padding: 20px; }
    .email-card { background: #ffffff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); overflow: hidden; }
    .header { background: linear-gradient(135deg, #c2185b 0%, #e91e63 100%); padding: 32px 24px; text-align: center; }
    .logo { width: 48px; height: 48px; background: white; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px; }
    .logo svg { width: 28px; height: 28px; }
    .header h1 { color: white; font-size: 24px; font-weight: 600; }
    .content { padding: 32px 24px; }
    .greeting { font-size: 18px; font-weight: 500; margin-bottom: 16px; color: #1f2330; }
    .message { font-size: 15px; color: #4a5060; margin-bottom: 24px; }
    .document-info { background: #fafafa; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #c2185b; }
    .document-info h3 { font-size: 16px; font-weight: 600; color: #1f2330; margin-bottom: 8px; }
    .document-info p { font-size: 14px; color: #6a7080; margin: 4px 0; }
    .btn { display: inline-block; background: linear-gradient(135deg, #c2185b 0%, #e91e63 100%); color: white; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 15px; transition: transform 0.2s, box-shadow 0.2s; }
    .btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(194, 24, 91, 0.4); }
    .btn-secondary { background: #f0f0f5; color: #c2185b; border: 1px solid #e0e0e8; }
    .btn-secondary:hover { background: #e8e8ef; }
    .footer { background: #fafafa; padding: 24px; text-align: center; border-top: 1px solid #e8e8ef; }
    .footer p { font-size: 12px; color: #8a8d9a; margin: 4px 0; }
    .footer a { color: #c2185b; text-decoration: none; }
    .divider { height: 1px; background: #e8e8ef; margin: 24px 0; }
    .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
    .badge-pending { background: #fff3e0; color: #e65100; }
    .badge-signed { background: #e8f5e9; color: #2e7d32; }
    .badge-rejected { background: #ffebee; color: #c62828; }
    .badge-completed { background: #e3f2fd; color: #1565c0; }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="email-card">
      <div class="header">
        <div class="logo">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none">
            <rect width="16" height="16" rx="3" fill="#c2185b"/>
            <path d="M4 8L7 11L12 5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h1>LetsSign</h1>
      </div>
      <div class="content">
        {{{body}}}
      </div>
      <div class="footer">
        <p><strong>LetsSign</strong> - Assinatura digital simples e segura</p>
        <p>{{anoAtual}} © LetsSign. Todos os direitos reservados.</p>
        <p><a href="{{frontendUrl}}">Acessar plataforma</a> | <a href="{{frontendUrl}}/privacidade">Política de Privacidade</a></p>
        <p>Se você não solicitou este e-mail, por favor ignore.</p>
      </div>
    </div>
  </div>
</body>
</html>