{{#> layout}}
<p class="greeting">Olá, {{nome}}! 👋</p>

<p class="message">Bem-vindo ao <strong>LetsSign</strong>! Sua conta foi criada com sucesso.</p>

<div class="document-info">
  <h3>🚀 Primeiros Passos</h3>
  <p>Agora você pode:</p>
  <ul style="margin: 12px 0; padding-left: 20px; color: #4a5060;">
    <li>Assinar documentos enviados para você</li>
    <li>Acompanhar o status de seus documentos</li>
    <li>Baixar PDFs finais assinados</li>
  </ul>
</div>

{{#if senhaTemporaria}}
<div style="background: #fff3e0; border: 1px solid #ffe0b2; border-radius: 8px; padding: 16px; margin: 24px 0;">
  <p style="margin: 0; font-size: 14px;"><strong>Senha temporária:</strong> <code style="background: #fff; padding: 4px 8px; border-radius: 4px; font-family: monospace;">{{senhaTemporaria}}</code></p>
  <p style="margin: 8px 0 0; font-size: 12px; color: #e65100;">Recomendamos alterar sua senha no primeiro acesso.</p>
</div>
{{/if}}

<div style="text-align: center; margin: 32px 0;">
  <a href="{{linkLogin}}" class="btn">Acessar Minha Conta</a>
</div>

<p class="message" style="font-size: 13px; color: #8a8d9a;">
  Se você não criou esta conta, por favor entre em contato com nosso suporte.
</p>
{{/layout}}