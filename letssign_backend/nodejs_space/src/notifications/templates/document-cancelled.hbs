{{#> layout}}
<p class="greeting">Olá, {{nomeDestinatario}}! ⚠️</p>

<p class="message">O documento <strong>{{tituloDocumento}}</strong> foi <strong>cancelado</strong>.</p>

<div class="document-info">
  <h3>📄 {{tituloDocumento}}</h3>
  <p><strong>Status:</strong> <span class="badge badge-rejected">Cancelado</span></p>
  {{#if motivoRecusa}}
  <p><strong>Motivo:</strong> {{motivoRecusa}}</p>
  {{/if}}
</div>

<div style="text-align: center; margin: 32px 0;">
  <a href="{{linkDocumento}}" class="btn btn-secondary">Ver Documento</a>
</div>

<p class="message" style="font-size: 13px; color: #8a8d9a;">
  Este documento não pode mais ser assinado. Se for necessário, entre em contato com o remetente para criar uma nova versão.
</p>
{{/layout}}