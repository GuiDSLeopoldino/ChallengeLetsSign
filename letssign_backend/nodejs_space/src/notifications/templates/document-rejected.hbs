{{#> layout}}
<p class="greeting">Olá, {{nomeDestinatario}}! ❌</p>

<p class="message">O documento <strong>{{tituloDocumento}}</strong> foi <strong>recusado</strong> por <strong>{{nomeRemetente}}</strong>.</p>

<div class="document-info">
  <h3>📄 {{tituloDocumento}}</h3>
  <p><strong>Recusado por:</strong> {{nomeRemetente}}</p>
  <p><strong>Status:</strong> <span class="badge badge-rejected">Recusado</span></p>
  {{#if motivoRecusa}}
  <p><strong>Motivo:</strong> {{motivoRecusa}}</p>
  {{/if}}
</div>

<div style="text-align: center; margin: 32px 0;">
  <a href="{{linkDocumento}}" class="btn btn-secondary">Ver Detalhes</a>
</div>

<p class="message" style="font-size: 13px; color: #8a8d9a;">
  Como o documento foi recusado por um signatário obrigatório, o fluxo de assinatura foi cancelado.
  Se necessário, o remetente pode criar uma nova versão com as correções.
</p>
{{/layout}}