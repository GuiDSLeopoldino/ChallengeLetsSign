{{#> layout}}
<p class="greeting">Olá, {{nomeDestinatario}}! ✅</p>

<p class="message">O documento <strong>{{tituloDocumento}}</strong> foi assinado por <strong>{{nomeRemetente}}</strong>.</p>

<div class="document-info">
  <h3>📄 {{tituloDocumento}}</h3>
  <p><strong>Assinado por:</strong> {{nomeRemetente}}</p>
  <p><strong>Status:</strong> <span class="badge badge-signed">Assinado</span></p>
</div>

<div style="text-align: center; margin: 32px 0;">
  <a href="{{linkDocumento}}" class="btn">Ver Documento</a>
</div>

<p class="message" style="font-size: 13px; color: #8a8d9a;">
  Você pode acompanhar o andamento das demais assinaturas acessando o documento.
</p>
{{/layout}}