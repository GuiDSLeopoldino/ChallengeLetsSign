{{#> layout}}
<p class="greeting">Olá, {{nomeDestinatario}}! ⏰</p>

<p class="message">Lembrete amigável: você ainda tem uma assinatura pendente no documento <strong>{{tituloDocumento}}</strong>.</p>

<div class="document-info">
  <h3>📄 {{tituloDocumento}}</h3>
  <p><strong>Status:</strong> <span class="badge badge-pending">Pendente</span></p>
  <p>Sua assinatura é necessária para concluir este documento.</p>
</div>

<div style="text-align: center; margin: 32px 0;">
  <a href="{{linkDocumento}}" class="btn">Assinar Agora</a>
</div>

<p class="message" style="font-size: 13px; color: #8a8d9a;">
  Este é um lembrete automático. Se você já assinou, por favor ignore este e-mail.
</p>
{{/layout}}