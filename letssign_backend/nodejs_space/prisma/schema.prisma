generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "windows", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SIGNER
}

enum DocumentStatus {
  DRAFT
  PENDING
  PARTIALLY_SIGNED
  COMPLETED
  CANCELLED
}

enum SignerStatus {
  PENDING
  VIEWED
  SIGNED
  REJECTED
}

enum RoleLabel {
  CONTRATANTE
  CONTRATADO
  TESTEMUNHA
}

enum AuditType {
  CREATED
  FIELDS_UPDATED
  SENT
  VIEWED
  SIGNED
  REJECTED
  VERSION_CREATED
  COMPLETED
}

model user {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  telefone     String?
  senhaHash    String
  role         Role
  adminId      String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  admin        user?            @relation("AdminSigners", fields: [adminId], references: [id])
  signers      user[]           @relation("AdminSigners")
  documents    document[]
  participacoes documentsigner[]
  fields       signaturefield[]

  @@index([adminId])
}

model document {
  id             String         @id @default(uuid())
  ownerId        String
  titulo         String
  status         DocumentStatus @default(DRAFT)
  versao         Int            @default(1)
  hashSha256     String
  tamanhoBytes   Int
  nomeArquivo    String
  totalPaginas   Int
  pdf            Bytes
  pdfFinal       Bytes?
  hashFinal      String?
  mensagem       String?
  criadoEm       DateTime       @default(now())
  enviadoEm      DateTime?
  concluidoEm    DateTime?
  atualizadoEm   DateTime       @updatedAt

  owner     user              @relation(fields: [ownerId], references: [id])
  versions  documentversion[]
  fields    signaturefield[]
  signers   documentsigner[]
  events    auditevent[]

  @@index([ownerId, status])
}

model documentversion {
  id           String   @id @default(uuid())
  documentId   String
  versao       Int
  hashSha256   String
  nomeArquivo  String
  tamanhoBytes Int
  pdf          Bytes
  configuracao Json?
  criadoEm     DateTime @default(now())

  document document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versao])
}

model signaturefield {
  id         String    @id @default(uuid())
  documentId String
  signerId   String
  page       Int
  x          Float
  y          Float
  width      Float
  height     Float
  required   Boolean   @default(true)
  roleLabel  RoleLabel
  criadoEm   DateTime  @default(now())

  document document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer   user     @relation(fields: [signerId], references: [id])

  @@index([documentId])
  @@index([signerId])
}

model documentsigner {
  id                      String       @id @default(uuid())
  documentId              String
  signerId                String
  status                  SignerStatus @default(PENDING)
  roleLabel               RoleLabel
  required                Boolean      @default(true)
  ordem                   Int          @default(0)
  invitedAt               DateTime?
  viewedAt                DateTime?
  signedAt                DateTime?
  rejectedAt              DateTime?
  motivoRecusa            String?
  assinaturaImagemBase64  String?
  gestureMetadata         Json?
  ip                      String?
  userAgent               String?

  document document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer   user     @relation(fields: [signerId], references: [id])

  @@unique([documentId, signerId])
  @@index([signerId, status])
}

model auditevent {
  id                     String    @id @default(uuid())
  documentId             String
  tipo                   AuditType
  actorId                String?
  actorRole              Role?
  descricao              String
  versao                 Int
  timestamp              DateTime  @default(now())
  ip                     String?
  hashDocumentoNoMomento String?
  metadados              Json?

  document document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, timestamp])
}
